# Copy to .env and replace the placeholder. Never put this value in the React app.
OPENAI_API_KEY=your_api_key_here
# Optional. The account must have access to the chosen model.
OPENAI_MODEL=gpt-5.6-terra
PORT=5173

# Lab 24: only this private MCP port is exposed by your tunnel.
LAB24_MCP_PORT=5174
# Optional public tunnel URL; include the exact /mcp path.
LAB24_PUBLIC_URL=
# Optional bearer token (at least 16 characters). Keep it server-side.
# Without this setting a random token is issued at each restart.
# Rotation tokens are in memory; update the vault after restarting.
LAB24_MCP_TOKEN=

# Lab 32: local disposable Docker executor. Application key NEVER enters Docker.
# Create a restricted environment key in the Agents dashboard for the SAME owner/project.
OPENAI_EXECUTOR_API_KEY=
# Enable only after building sandbox/lab32 and reviewing its local setup guide.
LAB32_ENABLE_LOCAL_EXECUTOR=false

# Lab 34: standalone skills in a separate disposable Docker image.
# Reuses the two distinct keys above. Build sandbox/lab34 before enabling.
LAB34_ENABLE_LOCAL_EXECUTOR=false

LAB35_ENABLE_LOCAL_EXECUTOR=false

LAB36_ENABLE_LOCAL_EXECUTOR=false
LAB37_ENABLE_LOCAL_EXECUTOR=false

# Lab 44: live webhook signing secret. Local signed fixtures need no configuration.
OPENAI_WEBHOOK_SECRET=
