      "criteria": [
        "AC-03"
      ],
      "kind": "upload",
      "input": {
        "name": "notes.txt",
        "content": "Search supports date filtering. Existing queries continue to work. Export returns a download URL; clients must fetch it."
      },
      "expected": "accept",
      "prompt": "Analyze my text notes.",
      "split": "regression"
    },
