  "dependencies": {
    "openai": "latest",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "latest",
    "typescript": "^7.0.2",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
