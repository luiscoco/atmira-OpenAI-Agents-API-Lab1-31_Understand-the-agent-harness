{
  "name": "agents-api-labs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:lab30": "node --import tsx --test server/lab30.integration.test.ts",
    "test:lab24": "node --import tsx --test server/lab24.integration.test.ts",
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lab6.json",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "test:lab31": "node --import tsx --test server/lab31.integration.test.ts",
    "test:lab32": "node --import tsx --test server/lab32.integration.test.ts",
    "test:lab33": "node --import tsx --test server/lab33.integration.test.ts",
    "test:lab36": "node --import tsx --test server/lab36.integration.test.ts",
    "test:lab37": "node --import tsx --test server/lab37.integration.test.ts",
    "test:lab38": "node --import tsx --test server/lab38.integration.test.ts",
    "test:lab39": "node --import tsx --test server/lab39.integration.test.ts",
    "test:capstone": "node --import tsx --test server/capstone.integration.test.ts",
    "test:integrations": "node --import tsx --test server/capstoneIntegrations.integration.test.ts",
    "verify:live": "node --import tsx scripts/verify-live-capstone.ts",
    "prepare:hooks": "node --import tsx scripts/prepare-native-hooks.ts",
    "capture:hooks": "node --import tsx scripts/capture-native-hooks.ts",
    "verify:hooks": "node --import tsx scripts/verify-native-hooks.ts",
    "eval:capstone": "node --import tsx scripts/evaluate-capstone.ts",
    "eval:live": "node --import tsx scripts/evaluate-live-capstone.ts",
    "verify:persistence": "node --import tsx scripts/check-capstone-persistence.ts",
    "verify:production": "node --import tsx scripts/verify-production-stack.ts",
    "start:capstone": "node --import tsx server/capstoneServer.ts",
    "smoke:capstone": "node --import tsx scripts/smoke-capstone.ts",
    "test:operations": "node --import tsx --test server/operations.integration.test.ts server/nativeVerification.integration.test.ts",
    "test:lab40": "node --import tsx --test server/lab40.integration.test.ts",
    "lab36:image": "docker build --tag agents-lab36-executor:local sandbox/lab36",
    "test:lab35": "node --import tsx --test server/lab35.integration.test.ts",
    "lab35:image": "docker build --tag agents-lab35-executor:local sandbox/lab35",
    "test:lab34": "node --import tsx --test server/lab34.integration.test.ts",
    "lab34:image": "docker build --tag agents-lab34-executor:local sandbox/lab34",
    "lab32:image": "docker build --tag agents-lab32-executor:local sandbox/lab32"
